{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimentum protocollo 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget_api_micro_usd",
    "calibration",
    "comparability",
    "components",
    "exclusions",
    "failure",
    "hypothesis",
    "id",
    "initial",
    "mode",
    "months",
    "objective",
    "primary",
    "publication",
    "replicas",
    "resources",
    "scenarios",
    "secondary",
    "shock",
    "stage",
    "statistics",
    "stopping",
    "success",
    "version"
  ],
  "properties": {
    "budget_api_micro_usd": {
      "const": 0
    },
    "calibration": {
      "type": "string"
    },
    "comparability": {
      "type": "string"
    },
    "components": {
      "type": "object"
    },
    "exclusions": {
      "type": "array"
    },
    "failure": {
      "type": "array"
    },
    "hypothesis": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "initial": {
      "type": "object"
    },
    "mode": {
      "type": "string"
    },
    "months": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "objective": {
      "type": "string"
    },
    "primary": {
      "type": "array"
    },
    "publication": {
      "type": "string"
    },
    "replicas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 18446744073709551615
      }
    },
    "resources": {
      "type": "object"
    },
    "scenarios": {
      "const": [
        "B"
      ]
    },
    "secondary": {
      "type": "array"
    },
    "shock": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "smoke",
        "pilot"
      ]
    },
    "statistics": {
      "type": "string"
    },
    "stopping": {
      "type": "string"
    },
    "success": {
      "type": "array"
    },
    "version": {
      "const": "experimentum-1.0"
    }
  }
}
